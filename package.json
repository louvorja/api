{
  "name": "api-louvorja",
  "version": "1.0.0",
  "description": "API LouvorJA — substituta de api.louvorja.com.br em Cloudflare Workers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "deploy": "npm run type-check && wrangler deploy",
    "type-check": "tsc --noEmit",
    "types": "wrangler types",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "node --env-file=.env --experimental-strip-types scripts/ingest.ts",
    "covers": "node --env-file=.env --experimental-strip-types scripts/convert-covers.ts",
    "parity": "node --env-file=.env --experimental-strip-types scripts/parity.ts",
    "sync:media": "node --env-file=.env --experimental-strip-types scripts/sync-media.ts",
    "bench": "node --env-file=.env --experimental-strip-types scripts/bench.ts",
    "ingest:rest": "node --env-file=.env --experimental-strip-types scripts/ingest-rest.ts",
    "d1:migrate": "wrangler d1 migrations apply louvorja --local",
    "d1:snapshot": "node --env-file=.env --experimental-strip-types scripts/pull-snapshot.ts",
    "d1:seed": "node --experimental-strip-types scripts/seed-d1.ts --snapshot=snapshot",
    "d1:user": "node --experimental-strip-types scripts/create-user.ts",
    "cutover:check": "node --experimental-strip-types scripts/check-cutover.ts",
    "test:cutover": "node --experimental-strip-types --test test/cutover.node.ts",
    "test:bundle-variants": "node --experimental-strip-types --test test/bundle-variants.node.ts",
    "catalog:diff": "node --experimental-strip-types scripts/catalog-diff.ts",
    "publish": "node --env-file-if-exists=.env --experimental-strip-types scripts/publish.ts",
    "publish:gate": "node --env-file-if-exists=.env --experimental-strip-types scripts/publish-gate.ts",
    "bundle:variants": "node --env-file-if-exists=.env --experimental-strip-types scripts/bundle-variants.ts",
    "delphi:db": "node --env-file-if-exists=.env --experimental-strip-types scripts/delphi-db.ts",
    "delphi:version": "node --env-file-if-exists=.env --experimental-strip-types scripts/delphi-version.ts",
    "test:delphi-version": "node --experimental-strip-types --test test/delphi-version.node.ts",
    "media:normalize": "node --env-file-if-exists=.env --experimental-strip-types scripts/media-normalize.ts",
    "test:media-plan": "node --experimental-strip-types --test test/media-plan.node.ts",
    "test:legacy-sqlite": "node --experimental-strip-types --test test/legacy-sqlite.node.ts",
    "rest:media": "node --env-file-if-exists=.env --experimental-strip-types scripts/rest-media.ts",
    "test:bible-publication": "node --experimental-strip-types --test test/bible-publication.node.ts",
    "files:reconcile": "node --env-file-if-exists=.env --experimental-strip-types scripts/reconcile-files.ts",
    "test:files-reconcile": "node --experimental-strip-types --test test/reconcile-files.node.ts",
    "online-videos:refresh": "node --env-file-if-exists=.env --experimental-strip-types scripts/refresh-online-videos.ts",
    "test:online-videos-refresh": "node --experimental-strip-types --test test/refresh-online-videos.node.ts",
    "slides:import": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-slides.ts",
    "test:slides-import": "node --experimental-strip-types --test test/import-slides.node.ts",
    "apps:versions": "node --env-file-if-exists=.env --experimental-strip-types scripts/apps-versions.ts",
    "test:apps-versions": "node --experimental-strip-types --test test/app-releases.node.ts test/delphi-version.node.ts",
    "test:release-notifications": "node --experimental-strip-types --test test/release-notifications.node.ts",
    "test:public-params": "node --experimental-strip-types --test test/public-params.node.ts"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@types/node": "^26.4.1",
    "aws4fetch": "^1.0.20",
    "bmp-js": "^0.1.0",
    "jpeg-js": "^0.4.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "wrangler": "^4.149.0"
  }
}
