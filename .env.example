# =============================================================
# api-louvorja — variáveis de ambiente (LOCAL, NUNCA COMMITAR)
# =============================================================

# ------------------------------------------------------------
# Conta Cloudflare
# ------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=ebfd182d9bc3913163758a88118752f5

# ------------------------------------------------------------
# R2 — bucket "files" (covers/, images/, musics/)
# Usado por scripts de ingestão/sync via S3 API (rclone, aws-cli).
# Em runtime o Worker acessa o bucket por binding, não por estas chaves.
# ------------------------------------------------------------
R2_ACCOUNT_ID=ebfd182d9bc3913163758a88118752f5
R2_BUCKET=files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ebfd182d9bc3913163758a88118752f5.r2.cloudflarestorage.com
R2_ACL=private

# ------------------------------------------------------------
# API legada louvorja.com.br — origem da engenharia reversa.
# Usada apenas pelos scripts de ingestão (seed do D1).
# ------------------------------------------------------------
LEGACY_API_URL=https://api.louvorja.com.br
LEGACY_API_TOKEN=

# Origem gravada nas URLs dos snapshots (capas, áudios, links de /params).
# É o endereço em que esta API responde. api.louvorja.com.br é do servidor
# antigo: só use outro domínio aqui se ele passar a apontar para este Worker.
PUBLIC_API_URL=https://api.louvorja.workers.dev

# ------------------------------------------------------------
# Painel (/auth e /admin) — assina os tokens de sessão.
# É o único valor daqui que o `wrangler dev` lê. Em produção vai
# por `wrangler secret put JWT_SECRET`, nunca por arquivo.
# Gere com: openssl rand -hex 32
# ------------------------------------------------------------
JWT_SECRET=

# ------------------------------------------------------------
# Integrações do Worker e dos jobs de manutenção
# GITHUB_TASK_TOKEN precisa poder disparar Actions no repositório da API;
# sem ele, /tasks responde 503 e o resto do Worker funciona normalmente.
# ------------------------------------------------------------
GITHUB_TASK_TOKEN=
YOUTUBE_API_KEY=

# Limpeza de /params após manutenção (zona louvorja.com.br).
# No GitHub: Zone ID em Variables e token em Secrets, com estes mesmos nomes.
# Token dedicado: permissão Zone > Cache Purge, restrita à zona louvorja.com.br.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=
